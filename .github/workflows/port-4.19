name: Port SM7150 to Linux 4.19

on:
  workflow_dispatch:

jobs:
  port:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout kernel
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Configure Git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

      - name: Check current kernel
        run: |
          echo "Current kernel:"
          make kernelversion

      - name: Fetch Linux 4.19
        run: |
          git remote add linux-stable \
            https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git

          git fetch linux-stable linux-4.19.y --no-tags

      - name: Create port branch
        run: |
          git switch -c port-4.19

      - name: Record current tree
        run: |
          mkdir -p port-info

          git rev-parse HEAD > port-info/current-commit.txt
          git branch --show-current > port-info/current-branch.txt
          make kernelversion > port-info/current-kernel-version.txt

      - name: Compare with Linux 4.19
        run: |
          git diff --stat linux-stable/linux-4.19.y > port-info/4.19-diff-stat.txt

          git log \
            --oneline \
            --decorate \
            --max-count=100 \
            > port-info/current-history.txt

      - name: Upload port analysis
        uses: actions/upload-artifact@v4
        with:
          name: sm7150-4.19-port-analysis
          path: port-info/
